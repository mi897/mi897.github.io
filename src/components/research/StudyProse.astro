---
// Styles for hand-authored study-plan HTML fragments (tables, checklists, gates, math blocks).
---
<style is:global>
  .study h2 { font-size: 1.5rem; font-weight: 700; line-height: 1.25; margin-bottom: 0.75rem; text-wrap: balance; }
  .study h3 { margin: 1.75rem 0 0.5rem; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.6; }
  .study p, .study li { max-width: 68ch; line-height: 1.65; }
  .study p { margin: 0.6rem 0; }
  .study .lead { font-size: 1.05rem; }
  .study .hours { opacity: 0.6; font-weight: 400; font-size: 1rem; white-space: nowrap; }
  .study ul:not(.checks), .study ol { padding-left: 1.25rem; margin: 0.5rem 0; }
  .study ul:not(.checks) { list-style: disc; }
  .study ol { list-style: decimal; }
  .study li + li { margin-top: 0.4rem; }
  .study a:not(.btn) { color: var(--color-primary); text-decoration: underline; text-underline-offset: 2px; }
  .study code { font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 0.88em; background: var(--color-base-300); padding: 1px 5px; border-radius: 4px; }
  .study pre.math { margin: 1rem 0; padding: 0.9rem 1rem; background: var(--color-base-300); border-radius: 0.5rem; font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 0.9rem; line-height: 1.6; overflow-x: auto; white-space: pre; }
  .study .tablewrap { overflow-x: auto; margin: 0.75rem 0; border-radius: 0.5rem; background: var(--color-base-200); }
  .study table { border-collapse: collapse; width: 100%; font-size: 0.92rem; }
  .study th, .study td { text-align: left; padding: 0.55rem 0.8rem; vertical-align: top; border-bottom: 1px solid color-mix(in oklab, var(--color-base-content) 15%, transparent); }
  .study th { font-size: 0.75rem; letter-spacing: 0.05em; text-transform: uppercase; opacity: 0.7; white-space: nowrap; }
  .study tr:last-child td { border-bottom: 0; }
  .study td.num, .study th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .study ul.checks { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  .study ul.checks li { margin: 0; max-width: none; }
  .study ul.checks label { display: grid; grid-template-columns: 22px 1fr; gap: 0.7rem; align-items: start; padding: 0.75rem 0.9rem; background: var(--color-base-200); border-radius: 0.5rem; cursor: pointer; }
  .study ul.checks input, .study .gate input { margin-top: 0.3rem; width: 18px; height: 18px; accent-color: var(--color-primary); }
  .study ul.checks .t { font-weight: 600; }
  .study ul.checks .h { opacity: 0.6; white-space: nowrap; }
  .study ul.checks input:checked ~ span { opacity: 0.6; }
  .study .gate { margin-top: 1.5rem; padding: 0.85rem 1rem; background: color-mix(in oklab, var(--color-warning) 14%, var(--color-base-200)); border-left: 4px solid var(--color-warning); border-radius: 0 0.5rem 0.5rem 0; }
  .study .gate label { display: grid; grid-template-columns: 22px 1fr; gap: 0.7rem; cursor: pointer; max-width: none; }
  .study .gate input { accent-color: var(--color-warning); }
  .study .note { padding: 0.75rem 0.9rem; background: color-mix(in oklab, var(--color-primary) 14%, var(--color-base-200)); border-radius: 0.5rem; margin: 1rem 0; max-width: 68ch; }
</style>
