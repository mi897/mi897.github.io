---
import { statusBadge, type Paper } from "../../lib/research";
interface Props { paper: Paper; }
const { paper } = Astro.props;
const search = [paper.title, paper.authors, paper.arxiv_id, paper.abstract_summary, paper.conclusion_summary ?? "", paper.note ?? ""].join(" ").toLowerCase();
---

<article class="paper-card card bg-base-200 shadow-sm" data-search={search} id={`p-${paper.arxiv_id}`}>
  <div class="card-body p-5 gap-3">
    <div class="flex flex-wrap items-start justify-between gap-2">
      <h3 class="card-title text-lg leading-snug basis-full sm:basis-auto sm:flex-1">{paper.title}</h3>
      <span class={`badge ${statusBadge[paper.status]}`}>{paper.status}</span>
    </div>
    <p class="text-sm opacity-80">
      {paper.authors} · {paper.date} ·
      <a class="link link-primary" href={paper.url} target="_blank" rel="noopener noreferrer">arXiv:{paper.arxiv_id} ↗</a>
    </p>
    {paper.note && <p class="text-sm italic opacity-80">{paper.note}</p>}
    <div class="grid gap-4 md:grid-cols-2">
      <section>
        <h4 class="text-xs font-semibold uppercase tracking-wide opacity-60 mb-1">Abstract (summary)</h4>
        <p class="text-sm leading-relaxed">{paper.abstract_summary}</p>
      </section>
      <section>
        <h4 class="text-xs font-semibold uppercase tracking-wide opacity-60 mb-1">Conclusion (summary)</h4>
        {paper.conclusion_summary
          ? <p class="text-sm leading-relaxed">{paper.conclusion_summary}</p>
          : <p class="text-sm leading-relaxed opacity-60">Not summarized yet.</p>}
      </section>
    </div>
    <section class="rounded-box bg-base-100 p-3">
      <h4 class="text-xs font-semibold uppercase tracking-wide opacity-60 mb-1">My notes</h4>
      {paper.my_notes
        ? <p class="text-sm whitespace-pre-line">{paper.my_notes}</p>
        : <p class="text-sm opacity-50">No notes yet.</p>}
    </section>
  </div>
</article>
